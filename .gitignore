# Backup artefacts. These belong in MUFC_Analytics/_archive/<date>/, never in a
# working tree — see the `bak` function in ~/.zshrc. Two orphaned copies of
# index.html (1.6 MB each) reached this repo before this file existed.
*.bak
*.bak_*
*.orig
*.rej

# macOS
.DS_Store
# The staff export. app.js fetches private/<code>-staff.json when __STAFF__ is
# set. It must never reach the public folder — this makes that enforceable
# rather than remembered.
private/
staff-preview.html
preview.html
build/staging/

# Python bytecode, since build/ became importable when names.py landed.
__pycache__/
*.pyc
